NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# used for sitemap.xml, robots.txt, and Open Graph URLs — set to the
# production domain; falls back to prometemad-steel.vercel.app if unset
NEXT_PUBLIC_SITE_URL=

# server-only: n8n webhook that performs image generation
N8N_GENERATE_IMAGE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# server-only: used by the prompt enhancer (/api/enhance-prompt) and the
# admin "generate prompt" assist (/api/admin/generate-prompt)
GEMINI_API_KEY=

# server-only: used by scripts/seed-preview-images.ts and by the
# /api/brand-logo upload route (Supabase Storage's JWT verification currently
# rejects this project's ES256 session tokens, so that route uploads on the
# user's behalf with this key instead). Never expose to the client, never
# commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
