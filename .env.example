NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# used for sitemap.xml, robots.txt, and Open Graph URLs — set to the
# production domain; falls back to prometemad-steel.vercel.app if unset
NEXT_PUBLIC_SITE_URL=

# server-only: n8n webhook that performs image generation
N8N_GENERATE_IMAGE_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# dev-only: used solely by scripts/seed-preview-images.ts to backfill prompt
# preview images. Never expose to the client, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
